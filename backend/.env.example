# Application
NODE_ENV=development
PORT=8080

# Database
# Local example: mongodb://localhost:27017/heritage-db
# Production example: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/heritage-db

# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=your_webhook_secret_here
BOOTSTRAP_ADMIN_CLERK_ID=your_bootstrap_admin_clerk_user_id_here
BOOTSTRAP_ADMIN_EMAIL=your_bootstrap_admin_email_here
BOOTSTRAP_ADMIN_NAME=Bootstrap Admin

# CORS
# Comma-separated list for multiple frontends, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:5173

# Security
# 900000 ms = 15 min
RATE_LIMIT_TTL=900000
RATE_LIMIT_MAX=100
